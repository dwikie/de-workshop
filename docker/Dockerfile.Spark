FROM apache/spark:3.5.5

USER root

ARG HADOOP_VERSION=3.3.4
ARG ICEBERG_VERSION=1.9.2
ARG AWS_SDK_VERSION=1.11.1026

# S3A support matching the Hadoop version bundled with Spark
RUN set -eux; \
    curl -fL \
    "https://repo.maven.apache.org/maven2/org/apache/hadoop/hadoop-aws/${HADOOP_VERSION}/hadoop-aws-${HADOOP_VERSION}.jar" \
    -o "/opt/spark/jars/hadoop-aws-${HADOOP_VERSION}.jar"; \
    curl -fL \
    "https://repo.maven.apache.org/maven2/com/amazonaws/aws-java-sdk-bundle/${AWS_SDK_VERSION}/aws-java-sdk-bundle-${AWS_SDK_VERSION}.jar" \
    -o "/opt/spark/jars/aws-java-sdk-bundle-${AWS_SDK_VERSION}.jar"; \
    curl -fL \
    "https://repo.maven.apache.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.5_2.12/${ICEBERG_VERSION}/iceberg-spark-runtime-3.5_2.12-${ICEBERG_VERSION}.jar" \
    -o "/opt/spark/jars/iceberg-spark-runtime-3.5_2.12-${ICEBERG_VERSION}.jar"; \
    chown spark:spark \
    "/opt/spark/jars/hadoop-aws-${HADOOP_VERSION}.jar" \
    "/opt/spark/jars/aws-java-sdk-bundle-${AWS_SDK_VERSION}.jar" \
    "/opt/spark/jars/iceberg-spark-runtime-3.5_2.12-${ICEBERG_VERSION}.jar"

USER spark
